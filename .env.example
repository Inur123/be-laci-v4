SSO_PROVISIONING_SECRET=

# Role bisnis LACI. Utamakan subject; email hanya alternatif operasional.
SSO_CABANG_SUBJECTS=
SSO_CABANG_EMAILS=
ALLOWED_ORIGINS=localhost
