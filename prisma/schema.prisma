generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  role           Role      @default(SEKRETARIS_PAC)
  isActive       Boolean   @default(false)
  banned         Boolean?  @default(false)
  banReason      String?
  banExpires     DateTime?
  periodeAktifId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLogoutAt   DateTime?

  // Existing relations
  arsipSurats      ArsipSurat[]
  berkasPimpinans  BerkasPimpinan[]
  berkasSPs        BerkasSP[]
  pengajuanBerkass PengajuanBerkas[]
  periodes         Periode[]
  agendaKegiatan   AgendaKegiatan[]
  presensi         Presensi[]
  logActivities    LogActivity[]

  // Sesi lokal LACI dan identitas OIDC yang tertaut
  sessions Session[]
  accounts Account[]

  // Wilayah relations
  ranting  Ranting[]
  pk       PK[]

  // Eksternal Anggota
  anggota  Anggota[]

  @@index([role, isActive, emailVerified])
  @@index([createdAt])
}

model Periode {
  id                String            @id @default(cuid())
  nama              String
  userId            String
  isActive          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  arsipSurats       ArsipSurat[]
  berkasPimpinans   BerkasPimpinan[]
  berkasSPs         BerkasSP[]
  pengajuanToPAC    PengajuanBerkas[] @relation("PengajuanToPAC")
  pengajuanToCabang PengajuanBerkas[] @relation("PengajuanToCabang")
  agendaKegiatan    AgendaKegiatan[]
  presensi          Presensi[]
  logActivities     LogActivity[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rantingData       RantingDataPeriode[]
  pkData            PKDataPeriode[]
  anggota           Anggota[]

  @@unique([nama, userId])
  @@index([userId])
}

model ArsipSurat {
  id               String      @id @default(cuid())
  userId           String
  periodeId        String
  noSurat          String
  jenisSurat       JenisSurat
  tanggal          DateTime
  pengirimPenerima String
  deskripsi        String?
  file             String?
  perihal          String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  organisasi       Organisasi?
  periode          Periode     @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
  @@index([tanggal])
  @@index([createdAt])
}

model BerkasSP {
  id              String     @id @default(cuid())
  userId          String
  periodeId       String
  nama            String
  tanggalMulai    DateTime
  tanggalBerakhir DateTime
  catatan         String?
  file            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  organisasi      Organisasi
  periode         Periode    @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
}

model BerkasPimpinan {
  id        String   @id @default(cuid())
  userId    String
  periodeId String
  nama      String
  tanggal   DateTime
  catatan   String?
  file      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  periode   Periode  @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
}

model PengajuanBerkas {
  id              String          @id @default(cuid())
  userId          String
  periodeId       String
  periodeIdPac    String
  noSurat         String
  penerima        PenerimaSurat
  tanggal         DateTime
  keperluan       String
  deskripsi       String?
  file            String
  status          StatusPengajuan @default(PENDING)
  alasanPenolakan String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  periodePac      Periode         @relation("PengajuanToPAC", fields: [periodeIdPac], references: [id], onDelete: Cascade)
  periodeCabang   Periode         @relation("PengajuanToCabang", fields: [periodeId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([periodeId])
  @@index([periodeIdPac])
}

model Presensi {
  id            String         @id @default(cuid())
  userId        String
  periodeId     String
  namaKegiatan  String
  tempat        String
  penyelenggara String
  tanggal       DateTime
  jamMulai      String
  jamSelesai    String
  isActive      Boolean        @default(true)
  isForcedOpen  Boolean        @default(false)
  forcedOpenAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  periode       Periode        @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataPresensi  PresensiData[]

  @@index([userId, periodeId])
}

model PresensiData {
  id          String   @id @default(cuid())
  presensiId  String
  namaLengkap String
  email       String
  noHp        String
  emailHash   String
  noHpHash    String
  organisasi  String
  tingkat     String?
  jabatan     String?
  instansi    String?
  createdAt   DateTime @default(now())
  presensi    Presensi @relation(fields: [presensiId], references: [id], onDelete: Cascade)

  @@unique([presensiId, emailHash])
  @@unique([presensiId, noHpHash])
  @@index([presensiId])
}

enum Role {
  SEKRETARIS_CABANG
  SEKRETARIS_PAC
}

enum JenisSurat {
  MASUK
  KELUAR
}

enum Organisasi {
  IPNU
  IPPNU
  BERSAMA
  CBP_KPP
}

enum StatusPengajuan {
  PENDING
  DITERIMA
  DITOLAK
}

enum PenerimaSurat {
  IPNU
  IPPNU
  BERSAMA
  CBP_KPP
}

enum StatusWilayah {
  AKTIF
  VAKUM
}

model Ranting {
  id        String    @id @default(cuid())
  userId    String
  nama      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataPeriode RantingDataPeriode[]
  
  @@index([userId])
}

model RantingDataPeriode {
  id        String        @id @default(cuid())
  rantingId String
  periodeId String
  status    StatusWilayah @default(AKTIF)
  namaKetua String?
  noHp      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  ranting   Ranting       @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  periode   Periode       @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@unique([rantingId, periodeId])
  @@index([periodeId])
}

model PK {
  id        String    @id @default(cuid())
  userId    String
  nama      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataPeriode PKDataPeriode[]
  
  @@index([userId])
}

model PKDataPeriode {
  id        String        @id @default(cuid())
  pkId      String
  periodeId String
  status    StatusWilayah @default(AKTIF)
  namaKetua String?
  noHp      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  pk        PK            @relation(fields: [pkId], references: [id], onDelete: Cascade)
  periode   Periode       @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@unique([pkId, periodeId])
  @@index([periodeId])
}

model AgendaKegiatan {
  id             String    @id @default(cuid())
  userId         String
  periodeId      String
  judul          String
  deskripsi      String?
  lokasi         String?
  warna          String
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  periode Periode @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
  @@index([tanggalMulai])
}

model AllowedOrigin {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogActivity {
  id          String    @id @default(cuid())
  userId      String
  periodeId   String
  action      LogAction
  module      LogModule
  description String
  entityId    String?

  // Informasi perangkat & jaringanre
  ipAddress String?
  userAgent String?
  browser   String?
  device    String?
  location  String?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  periode Periode @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId, createdAt(sort: Desc)])
  @@index([module, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

enum LogModule {
  ARSIP_SURAT
  ANGGOTA
  BERKAS_PIMPINAN
  BERKAS_SP
  AGENDA_KEGIATAN
  PENGAJUAN_BERKAS
  PERIODE
  USER
  AUTH
  PRESENSI
  RANTING
  PK
}

// ============================================
// EMAIL LOG
// ============================================

model LogEmail {
  id           String      @id @default(cuid())
  to           String
  subject      String
  type         EmailType
  status       EmailStatus @default(PENDING)
  errorMessage String?
  retryCount   Int         @default(0)
  metadata     String? // JSON string for extra info
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([to, createdAt(sort: Desc)])
}

enum EmailType {
  PENGAJUAN_USER
  PENGAJUAN_ADMIN
  PENGAJUAN_STATUS
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ============================================
// LOCAL SESSION AND OIDC IDENTITY MODELS
// ============================================

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String   // Nama layanan pengguna API (contoh: "Sistem Anggota")
  key       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SsoState {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

model Anggota {
  id          String           @id @default(cuid())
  userId      String           // Akun Pengelola di Laci
  periodeId   String
  namaLengkap String
  tingkat     String           // CABANG / PAC / RANTING / PK
  jabatan     String?
  wilayahId   String?          // Referensi ke Ranting / PK jika perlu
  status      StatusVerifikasi @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  periode     Periode          @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId, status])
}

enum StatusVerifikasi {
  PENDING
  TERVERIFIKASI
  DITOLAK
}
